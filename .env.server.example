NODE_ENV=production
PORT=3100
MEIAO_DB_HOST=127.0.0.1
MEIAO_DB_PORT=3307
MEIAO_DB_USER=root
MEIAO_DB_PASSWORD=
MEIAO_DB_NAME=meiao_internal
MEIAO_PUBLIC_BASE_URL=http://127.0.0.1:3100
MEIAO_JOB_MAX_CONCURRENCY=3
MEIAO_TASK_ENGINE=mysql
MEIAO_TEMPORAL_ADDRESS=127.0.0.1:7233
MEIAO_TEMPORAL_NAMESPACE=default
MEIAO_TEMPORAL_TASK_QUEUE=meiao-cloud
# provider 提交阶段卡住且尚未拿到 providerTaskId 的 running 任务兜底释放窗口。
# 云上建议 5 分钟，避免素材上传/提交异常长期占满同账号并发。
MEIAO_PROVIDERLESS_RUNNING_STALE_MS=300000
# 已提交上游并拿到 providerTaskId，但本地长时间未回写终态的 running 任务恢复窗口。
# 默认 6 小时；到期后回收到 retry_waiting 复查上游结果，并不继续占账号并发。
MEIAO_SUBMITTED_RUNNING_STALE_MS=21600000
# stale running 任务回收检查间隔。云上建议 30 秒。
MEIAO_STALE_RUNNING_RECONCILE_INTERVAL_MS=30000
# KIE 素材上传单次 HTTP 超时。分镜参考视频等较大素材需要更长上传预算。
MEIAO_KIE_ASSET_UPLOAD_TIMEOUT_MS=120000
# KIE HTTP 请求级瞬时重试次数(S2 G1)。fetch failed/ECONNRESET 等连接层错误对所有请求重试;
# 502/503/504 响应只对只读 GET(查询/下载)重试——提交类 POST 收到响应一律不重试,防重复扣费。默认 2。
# MEIAO_KIE_HTTP_TRANSIENT_RETRIES=2
# 请求级重试指数退避基数(毫秒),第 n 次重试等待 base*(2^n-1),默认 1000 → 1s、3s。
# MEIAO_KIE_HTTP_RETRY_BASE_MS=1000
# KIE 图片任务提交前解析/转存素材的单任务并发。详情页批量生图建议保持保守默认。
MEIAO_KIE_IMAGE_MEDIA_RESOLUTION_CONCURRENCY=2
# KIE Seedance 视频任务提交前解析/转存图片、视频、音频素材的单任务总并发。多张大图建议保持保守默认。
MEIAO_KIE_VIDEO_MEDIA_RESOLUTION_CONCURRENCY=2
# 智能体聊天 SSE 心跳间隔，避免长耗时多图生图时代理/浏览器空闲断流。默认 15000。
MEIAO_CHAT_SSE_HEARTBEAT_MS=15000
# 智能体单次生图提交/读取遇到 fetch failed、502、超时等瞬时上游错误时的内部快速重试次数。默认 1。
AGENT_IMAGE_GENERATE_TRANSIENT_MAX_RETRIES=1
# 智能体同一轮多张独立生图工具调用的执行并发。默认 2，代码上限 5；混合检索/生图仍保持串行。
AGENT_IMAGE_TOOL_CONCURRENCY=2
# 智能体模型规划/总结请求在尚未输出内容前遇到 fetch failed、超时等瞬时网络错误时的内部快速重试次数。默认 1。
AGENT_MODEL_TRANSIENT_MAX_RETRIES=1
MEIAO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 托管素材是否交给 Nginx X-Accel-Redirect 直出。默认关闭；只有部署了 /__meiao_stored_assets internal alias 后才设为 1。
MEIAO_ASSET_X_ACCEL=0
# 前端项目卡片视频预热阈值。默认预缓冲 3 秒，最多等 5 秒后仍会播放，避免云端大视频首帧后马上卡顿。
VITE_MEIAO_VIDEO_PLAYBACK_MIN_BUFFER_SECONDS=3
VITE_MEIAO_VIDEO_PLAYBACK_BUFFER_TIMEOUT_MS=5000
MEIAO_ADMIN_USERNAME=admin
MEIAO_ADMIN_PASSWORD=
MEIAO_SUPER_ADMIN_USERS=admin
MEIAO_SPIDER_GATEWAY_URL=
MEIAO_SPIDER_API_KEY=
MEIAO_DEFAULT_CHAT_MODEL=
MEIAO_DEFAULT_ANALYSIS_MODEL=
MEIAO_PLANNING_ANALYSIS_MODEL=
MEIAO_AGENT_ANALYSIS_MODEL=
KIE_API_KEY=
MEIAO_KIE_API_KEY=
APIPORTS_API_KEY=
MEIAO_APIPORTS_API_KEY=
APIPORTS_BASE_URL=https://apiports.com/v1/api/generate
KIE_CHAT_MODEL=
ARK_API_KEY=

# app_states 单行 state_json 写入大小上限(字节)。超过则按 updatedAt 倒序裁剪最老项目。
# 不配走代码默认 4 MiB(server/index.mjs)。锚定 MySQL max_allowed_packet 的几分之一。
# 线上 2026-06-14 据真实数据(41 用户,最大 3.8 MiB,0 人超闸)调到 8 MiB 缓冲。
# 线上 2026-07-04 再调到 16777216(16 MiB):妙木山 8.76 MiB 已超 8 MiB 闸正在丢老项目;
# 线上 max_allowed_packet 实测 128 MiB,16 MiB 仍有 8 倍余量。
APP_STATE_MAX_BYTES=16777216

# /api/health 里 temporal worker poller 探测结果的缓存毫秒数(避免高频 health 打 gRPC)。默认 10000。
# MEIAO_WORKER_HEALTH_CACHE_MS=10000

# 存储合并守卫:「无身份活跃占位」(无 backendJobId/providerTaskId 等、status 还在 generating/pending)超过该毫秒龄即标结构化失败(errorCode=identityless_placeholder_expired)。默认 21600000(6h,远大于任何正常提交耗时)。
# MEIAO_IDENTITYLESS_ACTIVE_TTL_MS=21600000

# ── 智能体 tool calling 中转站（第2期：生图工具调用）────────────
# 配置后，modelPolicy.toolCallingProvider='openai_compatible' 的智能体走原生 tool calling 对话
# OPENAI_COMPATIBLE_API_KEY=sk-xxxx
# OPENAI_COMPATIBLE_BASE_URL=https://maxforai.top
# 允许的模型白名单（逗号分隔），防止误配不存在模型导致 503
# OPENAI_COMPATIBLE_MODELS=gpt-5.4,gpt-5.5
# 请求超时（毫秒），默认 240000
# OPENAI_COMPATIBLE_TIMEOUT_MS=240000
# responses 端点路径，默认 /v1/responses；第4期多工具的 web_search 只走 responses
# OPENAI_COMPATIBLE_RESPONSES_PATH=/v1/responses

# ── AI 客服 Chatwoot 自动回复 ─────────────────
# 默认复用 OPENAI_COMPATIBLE_DEFAULT_MODEL 或 OPENAI_COMPATIBLE_MODELS 的第一个模型。
# CHATWOOT_AI_MODEL=gpt-5.4
# 可选：给 /api/chatwoot/ai-webhook 增加共享密钥；配置后 Chatwoot webhook URL 需追加 ?secret=同值，
# 或在上游转发时带 x-meiao-webhook-secret 请求头。本地测试不配置则允许直接调用。
# MEIAO_CHATWOOT_AI_WEBHOOK_SECRET=

# ── 智能工厂模型供应商 / CLI 工具（Smart Factory）────────────
# 智能工厂模型页的 credentialRef 使用 env:OPENAI_COMPATIBLE_API_KEY 等引用，不保存明文密钥。
# OPENAI_COMPATIBLE_API_KEY=sk-xxxx
# 飞书表格 CLI executor。必须是 JSON 数组，后台用 execFile 无 shell 执行，并通过 stdin 传入 {"executorRef","args"}。
# 不配置时 feishu.create_sheet 会明确失败，不会返回假链接。
# SMART_FACTORY_CLI_FEISHU_CREATE_SHEET_COMMAND=["node","/opt/meiao-tools/feishu-create-sheet.mjs"]

# ── 知识库 RAG embedding（第3期）────────────────
# EMBEDDING_PROVIDER=doubao
# DOUBAO_EMBEDDING_API_KEY=ark-xxxx
# DOUBAO_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-251215
# EMBEDDING_MIN_SIMILARITY=0.3
# EMBEDDING_TIMEOUT_MS=30000

# ── 智能体多工具（第4期）────────────────
# 复用第2期 OPENAI_COMPATIBLE_*。V2 对话走 /v1/responses 端点（支持 web_search）。
# 工具调用循环上限，防止模型反复调用工具失控；默认 5。
# AGENT_TOOL_MAX_ROUNDS=5
# 多图独立输出规划欠覆盖时的模型修复轮数上限；默认 2。仍不完整则快速失败，不执行单张伪完成。
# AGENT_IMAGE_PLAN_REPAIR_MAX_ROUNDS=2
