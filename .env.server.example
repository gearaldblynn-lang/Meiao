NODE_ENV=production
PORT=3100
# 正式服务默认监听全部网卡；首次集群迁移的临时候选进程必须覆盖为 127.0.0.1。
MEIAO_BIND_HOST=0.0.0.0
MEIAO_DB_HOST=127.0.0.1
MEIAO_DB_PORT=3307
MEIAO_DB_USER=root
MEIAO_DB_PASSWORD=
MEIAO_DB_NAME=meiao_internal
MEIAO_PUBLIC_BASE_URL=http://127.0.0.1:3100
MEIAO_JOB_MAX_CONCURRENCY=3
# 产品还原新任务创建灰度：off 关闭，admin 仅管理员，all 所有已登录用户。空值或非法值均按 off 处理。
# 只控制新建任务，不影响已有产品还原项目的查看与结果下载。
MEIAO_PRODUCT_RESTORE_ROLLOUT=off
# 同账号同语义付费任务的 MySQL 提交锁等待上限（秒），防止跨进程重复预留和提交。
MEIAO_JOB_SUBMISSION_LOCK_TIMEOUT_SECONDS=10
MEIAO_TASK_ENGINE=mysql
MEIAO_TEMPORAL_ADDRESS=127.0.0.1:7233
MEIAO_TEMPORAL_NAMESPACE=default
MEIAO_TEMPORAL_TASK_QUEUE=meiao-cloud
# Temporal activity heartbeat 间隔，须低于 workflow 的 30 秒 heartbeat timeout；允许 1000-15000，默认 10000。
MEIAO_TEMPORAL_ACTIVITY_HEARTBEAT_MS=10000
# 部署脚本在 PM2 平滑 reload 前使用的写请求/worker drain marker。通常不需要配置；自定义时必须保证脚本与服务端读取同一路径。
# 仅历史空 marker 超过默认 10 分钟会失效；带 owner token 或 manual 的 marker 永不自动失效。
# MEIAO_DEPLOY_DRAIN_FILE=/tmp/meiao-deploy-drain
# MEIAO_DEPLOY_DRAIN_MAX_AGE_MS=600000
# worker 领取任务与部署最终屏障共用的 MySQL 命名锁等待上限（秒）。
MEIAO_DEPLOY_JOB_CLAIM_LOCK_TIMEOUT_SECONDS=10
# PM2 等待新进程 ready 与旧进程优雅退出的上限（毫秒）。
MEIAO_PM2_LISTEN_TIMEOUT_MS=120000
MEIAO_PM2_KILL_TIMEOUT_MS=30000
# 生产 PM2 master 可由 root 管理，但应用子进程使用专用非 root 账号。两项必须同时配置。
MEIAO_APP_SERVICE_USER=
MEIAO_APP_SERVICE_GROUP=
# 本地发布脚本轮询上限：写请求排空每次 0.5s，health 每次 2s。
# MEIAO_DEPLOY_WRITE_DRAIN_ATTEMPTS=120
# MEIAO_DEPLOY_HEALTH_ATTEMPTS=60
# provider 提交阶段卡住且尚未拿到 providerTaskId 的 running 任务异常检测窗口。
# 云上建议 5 分钟；外部付费任务进入 provider_submission_unknown，只释放并发，不自动重提或退积分预留。
MEIAO_PROVIDERLESS_RUNNING_STALE_MS=300000
# 已提交上游并拿到 providerTaskId，但本地长时间未回写终态的 running 任务恢复窗口。
# 默认 6 小时；仅具备旧 ID 查询路径的 task type 回到 retry_waiting，不可查询的 chat response ID 停止自动恢复。
MEIAO_SUBMITTED_RUNNING_STALE_MS=21600000
# 已拿到 providerTaskId 后的轮询/结果下载恢复次数；不用于重新提交 create POST。
MEIAO_SUBMITTED_TASK_RECOVERY_RETRIES=2
# stale running 任务回收检查间隔。云上建议 30 秒。
MEIAO_STALE_RUNNING_RECONCILE_INTERVAL_MS=30000
# KIE 素材上传单次 HTTP 超时。分镜参考视频等较大素材需要更长上传预算。
MEIAO_KIE_ASSET_UPLOAD_TIMEOUT_MS=120000
# KIE 对话/Gemini 推理等待上限。默认 6 分钟，需高于 KIE 上游常见的 5 分钟超时，才能收到真实终态。
MEIAO_KIE_CHAT_COMPLETION_TIMEOUT_MS=360000
# Node 在 IPv4/IPv6 候选地址之间切换时，单个地址的 TCP 建连尝试窗口。跨境 provider 建议保留 1000ms。
MEIAO_NETWORK_FAMILY_ATTEMPT_TIMEOUT_MS=1000
# Gemini 托管视频默认写入私有腾讯 COS；若上游会先 HEAD 再 GET，可显式改为付费提交前 KIE 暂存。
# 两种模式都禁止在付费请求失败后自动重提、切换素材路由或切换模型。
MEIAO_GEMINI_VIDEO_MEDIA_MODE=cos-direct
# COS 模式请使用仅限目标桶 gemini-video/* 的最小权限子账号密钥。
MEIAO_COS_SECRET_ID=
MEIAO_COS_SECRET_KEY=
MEIAO_COS_BUCKET=
MEIAO_COS_REGION=ap-guangzhou
# 签名地址有效期，默认 3 小时；允许 300-86400 秒。
MEIAO_COS_SIGNED_URL_TTL_SECONDS=10800
# 未来用户上传的 source/reference/chat 图片专用私有 COS。模板默认 disabled 以防空配置误写。
# 生产标准发布必须先配成 cos 并通过五步真探针，否则部署在 PM2 平滑 reload 前中止；COS 失败不回落本地/KIE。
# 本地联调可显式设为 local，但仅 NODE_ENV=development/test 且 MEIAO_PUBLIC_BASE_URL 为本机/内网时生效。
# 不迁移历史图片，也不改生成结果的本地存储；不得复用上面的视频 COS 凭证。
MEIAO_MANAGED_IMAGE_UPLOAD_MODE=disabled
MEIAO_MANAGED_IMAGE_MAX_BYTES=20971520
# 至少 24 字符，用于新 COS 图片的不可猜访问 capability；轮换时先将旧值填入 PREVIOUS。
MEIAO_MANAGED_ASSET_ACCESS_SECRET=
MEIAO_MANAGED_ASSET_ACCESS_PREVIOUS_SECRET=
MEIAO_IMAGE_COS_SECRET_ID=
MEIAO_IMAGE_COS_SECRET_KEY=
MEIAO_IMAGE_COS_BUCKET=
MEIAO_IMAGE_COS_REGION=ap-guangzhou
MEIAO_IMAGE_COS_BROWSER_URL_TTL_SECONDS=300
MEIAO_IMAGE_COS_PROVIDER_URL_TTL_SECONDS=10800
MEIAO_IMAGE_COS_UPLOAD_MAX_ATTEMPTS=3
MEIAO_IMAGE_COS_UPLOAD_TIMEOUT_MS=30000
MEIAO_IMAGE_COS_UPLOAD_RETRY_BASE_MS=500
MEIAO_IMAGE_COS_OPERATION_TIMEOUT_MS=15000
# 完整 COS readiness 探针每 15 分钟运行，1 小时未成功即在 health 告警。
MEIAO_MANAGED_IMAGE_PROBE_INTERVAL_MS=900000
MEIAO_MANAGED_IMAGE_PROBE_MAX_AGE_MS=3600000
# 通常不需要覆盖；文件只保存时间、结果和不可逆配置指纹，不保存密钥。
MEIAO_MANAGED_IMAGE_PROBE_STATUS_FILE=server/data/managed-image-cos-readiness.json
# 清理队列与对账：失败不丢任务，进程重启后继续。health.managedAssetCleanup 暴露积压和最老等待时间。
# 先进入 delete_pending，延迟 2 分钟且删除前重新核对持久引用。
MEIAO_ASSET_DELETE_GRACE_MS=120000
# 同账号 COS 上传与账号删除的 MySQL advisory lock 等待上限（秒）。
MEIAO_ASSET_USER_LOCK_TIMEOUT_SECONDS=30
MEIAO_ASSET_LOCK_CONNECTION_LIMIT=20
MEIAO_ASSET_AGENT_BUSY_LEASE_MS=7200000
MEIAO_ASSET_CLEANUP_INTERVAL_MS=1800000
MEIAO_TOMBSTONED_JOB_RECONCILE_INTERVAL_MS=15000
MEIAO_TOMBSTONED_JOB_PENDING_ALERT_MS=900000
MEIAO_ASSET_CLEANUP_BATCH_SIZE=20
MEIAO_ASSET_CLEANUP_RETRY_BASE_MS=60000
MEIAO_ASSET_CLEANUP_MANUAL_REVIEW_ATTEMPTS=8
MEIAO_ASSET_CLEANUP_MANUAL_RETRY_MS=86400000
MEIAO_ASSET_CLEANUP_LEASE_MS=600000
MEIAO_ASSET_CLEANUP_ALERT_BACKLOG=100
MEIAO_ASSET_CLEANUP_ALERT_OLDEST_MS=86400000
MEIAO_ASSET_UPLOAD_STALE_MS=900000
MEIAO_ASSET_COS_RECONCILE_INTERVAL_MS=86400000
MEIAO_ASSET_CLEANUP_AUDIT_RETENTION_MS=2592000000
# 我方托管素材路由：auto 在 MEIAO_PUBLIC_BASE_URL 为公网 HTTPS 时直连优先，否则强制走 KIE；kie-only 可紧急回滚。
MEIAO_KIE_MANAGED_ASSET_MODE=auto
# 真正需要转存 KIE 时的跨任务进程级上传并发总上限。
MEIAO_KIE_ASSET_UPLOAD_CONCURRENCY=3
# 文件上传 POST 的瞬时连接错误及 429/500/502/503/504 响应重试预算与退避基数。
# 只作用于文件转存，不放宽 createTask/chat 等可能扣费的提交 POST。
MEIAO_KIE_ASSET_UPLOAD_RETRIES=2
MEIAO_KIE_ASSET_UPLOAD_RETRY_BASE_MS=1000
# 成功 KIE URL 的进程内缓存：默认 30 分钟、最多 2000 条；失败不缓存，PM2 重启自然清空。
MEIAO_KIE_ASSET_UPLOAD_CACHE_TTL_MS=1800000
MEIAO_KIE_ASSET_UPLOAD_CACHE_MAX_ENTRIES=2000
# provider 已完成后抓取结果文件的单次 GET/响应体读取超时、重试次数与线性退避基数。
# 只重试幂等下载的连接错误、超时、429/5xx；不会重提任何生成任务。
MEIAO_RESULT_ASSET_DOWNLOAD_TIMEOUT_MS=60000
MEIAO_RESULT_ASSET_DOWNLOAD_RETRIES=2
MEIAO_RESULT_ASSET_DOWNLOAD_RETRY_BASE_MS=500
# KIE HTTP 请求级瞬时重试次数(S2 G1)。付费 POST 只有明确停在 TCP connect 阶段时才安全重试；
# 连接建立后的 ECONNRESET/UND_ERR_SOCKET、主动超时及任何响应都不重提。502/503/504 默认只重试只读 GET。
# 文件上传 POST 由上面的 MEIAO_KIE_ASSET_UPLOAD_* 独立预算控制。默认 2。
# MEIAO_KIE_HTTP_TRANSIENT_RETRIES=2
# 请求级重试指数退避基数(毫秒),第 n 次重试等待 base*(2^n-1),默认 1000 → 1s、3s。
# MEIAO_KIE_HTTP_RETRY_BASE_MS=1000
# KIE 图片任务提交前解析/转存素材的单任务并发。详情页批量生图建议保持保守默认。
MEIAO_KIE_IMAGE_MEDIA_RESOLUTION_CONCURRENCY=2
# KIE Seedance 视频任务提交前解析/转存图片、视频、音频素材的单任务总并发。多张大图建议保持保守默认。
MEIAO_KIE_VIDEO_MEDIA_RESOLUTION_CONCURRENCY=2
# KIE chat/分镜策划提交前解析多媒体素材的单任务并发；与进程级上传总闸门叠加生效。
MEIAO_KIE_CHAT_MEDIA_RESOLUTION_CONCURRENCY=2
# 短视频参考音视频的临时裁剪转码。生产首发先设 0，确认 /api/health.mediaTranscode 两个 ready 后改 1。
# 原文件只在临时会话目录保留，成功转码并复检后才写入托管素材。
MEIAO_MEDIA_TRANSCODE_ENABLED=0
# 留空使用 npm 随包二进制；仅在运维明确提供系统版本时覆盖。
MEIAO_FFMPEG_PATH=
MEIAO_FFPROBE_PATH=
MEIAO_MEDIA_TRANSCODE_INPUT_MAX_BYTES=209715200
MEIAO_MEDIA_TRANSCODE_CONCURRENCY=1
MEIAO_MEDIA_TRANSCODE_TIMEOUT_MS=600000
MEIAO_MEDIA_PROBE_TIMEOUT_MS=30000
MEIAO_MEDIA_TRANSCODE_SESSION_TTL_MS=1800000
MEIAO_MEDIA_TRANSCODE_MAX_SESSIONS=20
# Golden 去字幕令牌仅写入服务端。生产默认关闭，就绪检查通过后再运行单次付费探针。
GOLDEN_SUBTITLE_API_TOKEN=
MEIAO_SUBTITLE_REMOVAL_ENABLED=0
# 可选上游地址覆盖；健康和公开配置不会返回该值。
MEIAO_SUBTITLE_REMOVAL_BASE_URL=https://goodline.simplemokey.com/api/openAi
# 轮询默认 5000ms，可调 2000-30000ms；总超时默认 1800000ms，可调 300000-7200000ms。
MEIAO_SUBTITLE_REMOVAL_POLL_INTERVAL_MS=5000
MEIAO_SUBTITLE_REMOVAL_TIMEOUT_MS=1800000
# 批量上限默认 10（范围 1-20）；素材准备和耐久 job 创建并发默认 2（范围 1-4）。
# 提交并发只控制创建节奏，不放宽 provider 重试、账号并发或付费安全策略。
MEIAO_SUBTITLE_REMOVAL_BATCH_MAX_ITEMS=10
MEIAO_SUBTITLE_REMOVAL_BATCH_PREP_CONCURRENCY=2
MEIAO_SUBTITLE_REMOVAL_BATCH_SUBMIT_CONCURRENCY=2
# 付费 canary 成功后的浏览器验收保留窗口；默认 0，发布验收可临时设置，最多 600000ms，窗口后自动清理。
MEIAO_SUBTITLE_REMOVAL_PROBE_INSPECTION_MS=0
# 口播翻译 disabled-first：只有本地 Demucs/Whisper/FFmpeg readiness、KIE 凭证和发布审批都通过后才改为 1。
# 关闭只阻止新任务；历史口播翻译卡片和托管结果继续可读。
MEIAO_VOICEOVER_TRANSLATION_ENABLED=0
# Python venv 与 mdx 权重必须由运维安装在 Git/发布目录之外；路径不会进入 health 或探针输出。
MEIAO_VOICEOVER_SEPARATION_PYTHON=
MEIAO_VOICEOVER_DEMUCS_MODEL=mdx
MEIAO_VOICEOVER_DEMUCS_MODEL_DIR=
# faster-whisper 与 Demucs 共用同一个固定 Python 3.11 venv；模型目录必须在 Git/release 之外且运行时只读。
MEIAO_VOICEOVER_ALIGNMENT_PYTHON=
MEIAO_VOICEOVER_WHISPER_MODEL_DIR=
# 强制对齐默认超时 600000ms（30000-3600000），stdout 上限 524288 bytes（16384-2097152）。
MEIAO_VOICEOVER_ALIGNMENT_TIMEOUT_MS=600000
MEIAO_VOICEOVER_ALIGNMENT_MAX_OUTPUT_BYTES=524288
# transcript 相似度默认 0.82（0.5-1）；每句声学边界最短默认 40ms（20-2000）。
MEIAO_VOICEOVER_ALIGNMENT_MIN_SIMILARITY=0.82
MEIAO_VOICEOVER_ALIGNMENT_MIN_TURN_DURATION_MS=40
# Demucs 一次性安装命令的网络参数；无需持久化到应用运行环境。非法值会 fail-closed。
# MEIAO_VOICEOVER_PIP_TIMEOUT_SECONDS=600
# MEIAO_VOICEOVER_PIP_RETRIES=8
# Demucs 与 Whisper 共用同一个重媒体 FIFO 许可；并发默认 1（范围 1-2），生产保持 1。
# 分离超时默认 3600000ms（范围 300000-7200000）。
MEIAO_VOICEOVER_SEPARATION_CONCURRENCY=1
MEIAO_VOICEOVER_SEPARATION_TIMEOUT_MS=3600000
# 仅发布前独立探针真实加载模型时使用；服务启动不加载模型。默认 120000ms（范围 30000-180000）。
MEIAO_VOICEOVER_READINESS_MODEL_TIMEOUT_MS=120000
# Gemini 分析内联音频字节上限，默认 12 MiB（范围 1 KiB-15 MiB）；超限在付费分析提交前拒绝。
MEIAO_GEMINI_INLINE_DATA_MAX_BYTES=12582912
# 新口播不再降速：短语音保持自然速度并按分段时间戳放置；长语音默认最多加速 1.75 倍。
# min 仅用于兼容旧检查点，范围 0.5-1；max 范围 1-2。
MEIAO_VOICEOVER_MIN_ATEMPO=0.75
MEIAO_VOICEOVER_MAX_ATEMPO=1.75
# Gemini 3.1 Flash TTS 输入上限默认 8192 tokens（范围 1-8192），跟随语音模型硬上限。
MEIAO_VOICEOVER_TTS_MAX_INPUT_TOKENS=8192
# version 2 新任务把全部译文一次性连续合成；group gap 只用于 version 1 历史恢复（范围 0-3000）。
# 时间戳重叠容差默认 150ms（范围 0-1000）。
MEIAO_VOICEOVER_GROUP_GAP_MS=800
MEIAO_VOICEOVER_TIMESTAMP_OVERLAP_TOLERANCE_MS=150
# 目标文本密度默认 24 bytes/s（范围 16-512），并要求空格分词语言不超过约 3 个口播词/秒。
# 异常长翻译会在创建 TTS 子任务前拒绝。
MEIAO_VOICEOVER_MAX_TARGET_TEXT_BYTES_PER_SECOND=24
# 从同一连续 TTS 裁出的每句边缘淡入淡出默认 40ms（范围 0-200）；成品不保留任何原视频音频。
MEIAO_VOICEOVER_FADE_MS=40
# 最终时长容差默认 100ms（范围 20-500）；中间素材 TTL 默认 259200000ms（范围 3600000-2592000000）。
MEIAO_VOICEOVER_DURATION_TOLERANCE_MS=100
MEIAO_VOICEOVER_INTERMEDIATE_TTL_MS=259200000
# 真实音色试听按账号/语言/音色永久复用；0 表示永久，也可配置 1-168 小时强制刷新。
MEIAO_VOICEOVER_PREVIEW_CACHE_TTL_MS=0
# 系统预置试听库生成器默认串行（范围 1-2）；单文件下载超时 60000ms（5000-300000），上限 20971520 bytes（1024-104857600）。
MEIAO_VOICE_PREVIEW_LIBRARY_CONCURRENCY=1
MEIAO_VOICE_PREVIEW_LIBRARY_DOWNLOAD_TIMEOUT_MS=60000
MEIAO_VOICE_PREVIEW_LIBRARY_MAX_BYTES=20971520
# MEIAO_VOICE_PREVIEW_LIBRARY_CONFIRM=1 是单次付费生成确认，只允许写在当前命令环境，禁止持久化到本文件。
# KIE Gemini 3.1 Flash TTS 服务端合同；模型名固定，非法值回落到该固定值。
MEIAO_KIE_TTS_BASE_URL=https://api.kie.ai
MEIAO_KIE_TTS_MODEL=google/gemini-3-1-flash-tts
# 单次请求超时默认 60000ms（5000-300000）；轮询默认 4000ms（500-30000）。
MEIAO_KIE_TTS_REQUEST_TIMEOUT_MS=60000
MEIAO_KIE_TTS_POLL_INTERVAL_MS=4000
# 轮询最多 180 次（1-720）；上游暂时 404 的宽限期默认 45000ms（0-300000）。
MEIAO_KIE_TTS_POLL_MAX_ATTEMPTS=180
MEIAO_KIE_TTS_NOT_FOUND_GRACE_MS=45000
# 口播探针的非敏感远程根地址和轮询合同；poll 默认 4000ms（500-30000），总超时默认 2400000ms（60000-7200000）。
MEIAO_VOICEOVER_PROBE_BASE_URL=
MEIAO_VOICEOVER_PROBE_POLL_INTERVAL_MS=4000
MEIAO_VOICEOVER_PROBE_TIMEOUT_MS=2400000
# MEIAO_VOICEOVER_PROBE_SESSION_TOKEN 只能在当前命令的临时环境中提供，禁止写入本文件。
# MEIAO_VOICEOVER_LIVE_CANARY_CONFIRMED=1 是单次付费确认，只接受启动探针前的命令环境；禁止持久化到 .env.server/.env.local。
# 智能体聊天 SSE 心跳间隔，避免长耗时多图生图时代理/浏览器空闲断流。默认 15000。
MEIAO_CHAT_SSE_HEARTBEAT_MS=15000
# 智能体单次生图提交/读取遇到 fetch failed、502、超时等瞬时上游错误时的内部快速重试次数。默认 1。
AGENT_IMAGE_GENERATE_TRANSIENT_MAX_RETRIES=1
# 智能体同一轮多张独立生图工具调用的执行并发。默认 2，代码上限 5；混合检索/生图仍保持串行。
AGENT_IMAGE_TOOL_CONCURRENCY=2
# 智能体模型规划/总结请求在尚未输出内容前遇到 fetch failed、超时等瞬时网络错误时的内部快速重试次数。默认 1。
AGENT_MODEL_TRANSIENT_MAX_RETRIES=1
MEIAO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 托管素材是否交给 Nginx X-Accel-Redirect 直出。默认关闭；只有部署了 /__meiao_stored_assets internal alias 后才设为 1。
MEIAO_ASSET_X_ACCEL=0
# 前端项目卡片视频预热阈值。默认预缓冲 3 秒，最多等 5 秒后仍会播放，避免云端大视频首帧后马上卡顿。
VITE_MEIAO_VIDEO_PLAYBACK_MIN_BUFFER_SECONDS=3
VITE_MEIAO_VIDEO_PLAYBACK_BUFFER_TIMEOUT_MS=5000
# 项目卡后台任务同步间隔（前端构建期变量）。默认 10000ms，低于 1000ms 会回退默认值。
VITE_MEIAO_SHELL_JOB_SYNC_INTERVAL_MS=10000
# 产品替换参考图批量提交并发；允许 1-6，默认 3。修改后需重新构建前端。
VITE_MEIAO_PRODUCT_REPLACE_SUBMISSION_CONCURRENCY=3
# 产品替换生图提示词付费前上限；超限停止、不截断产品身份。修改后需重新构建前端。
VITE_MEIAO_PRODUCT_REPLACE_GENERATION_PROMPT_MAX_CHARS=18000
VITE_MEIAO_PRODUCT_REPLACE_ANALYSIS_PROMPT_MAX_CHARS=12000
VITE_LOGO_REPLACE_GENERATION_PROMPT_MAX_CHARS=18000
# Logo 语义定位后实际编辑范围相对真实目标边界的外扩比例与边缘羽化比例；允许 0.02-0.5，修改后需重新构建前端。
VITE_LOGO_REPLACE_EDIT_PADDING_RATIO=0.18
VITE_LOGO_REPLACE_EDIT_FEATHER_RATIO=0.12
MEIAO_ADMIN_USERNAME=admin
MEIAO_ADMIN_PASSWORD=
MEIAO_SUPER_ADMIN_USERS=admin
MEIAO_SPIDER_GATEWAY_URL=
MEIAO_SPIDER_API_KEY=
MEIAO_DEFAULT_CHAT_MODEL=
MEIAO_DEFAULT_ANALYSIS_MODEL=
MEIAO_PLANNING_ANALYSIS_MODEL=
MEIAO_AGENT_ANALYSIS_MODEL=
KIE_API_KEY=
MEIAO_KIE_API_KEY=
APIPORTS_API_KEY=
MEIAO_APIPORTS_API_KEY=
APIPORTS_BASE_URL=https://apiports.com/v1/api/generate
# MaxForAI `image-2中转` 独立凭证；不要复用 OPENAI_COMPATIBLE_API_KEY。
MAXFORAI_API_KEY=
MAXFORAI_BASE_URL=https://maxforai.top/v1
# 付费生成 POST 不自动重试；此处只控制单次等待上限。
MAXFORAI_IMAGE_REQUEST_TIMEOUT_MS=600000
# 图生图参考素材在付费提交前下载并封装 multipart 文件的超时和并发。
MAXFORAI_ASSET_UPLOAD_TIMEOUT_MS=120000
MAXFORAI_ASSET_UPLOAD_CONCURRENCY=3
# MaxForAI `Seedance 2.0 Pro 特价` 视频渠道独立凭证；不回退、不复用上面的 Image-2 Key。
MAXFORAI_VIDEO_API_KEY=
MAXFORAI_VIDEO_BASE_URL=https://maxforai.top/v1
# 付费创建 POST 只提交一次；素材准备可在付费创建前做有限重试。
MAXFORAI_VIDEO_CREATE_TIMEOUT_MS=60000
MAXFORAI_VIDEO_ASSET_TIMEOUT_MS=120000
MAXFORAI_VIDEO_ASSET_UPLOAD_CONCURRENCY=2
MAXFORAI_VIDEO_POLL_INTERVAL_MS=5000
MAXFORAI_VIDEO_POLL_TIMEOUT_MS=1500000
KIE_CHAT_MODEL=
ARK_API_KEY=

# app_states 单行 state_json 写入大小上限(字节)。超过则按 updatedAt 倒序裁剪最老项目。
# 不配走代码默认 4 MiB(server/index.mjs)。锚定 MySQL max_allowed_packet 的几分之一。
# 线上 2026-06-14 据真实数据(41 用户,最大 3.8 MiB,0 人超闸)调到 8 MiB 缓冲。
# 线上 2026-07-04 再调到 16777216(16 MiB):妙木山 8.76 MiB 已超 8 MiB 闸正在丢老项目;
# 线上 max_allowed_packet 实测 128 MiB,16 MiB 仍有 8 倍余量。
APP_STATE_MAX_BYTES=16777216

# /api/health 里 temporal worker poller 探测结果的缓存毫秒数(避免高频 health 打 gRPC)。默认 10000。
# MEIAO_WORKER_HEALTH_CACHE_MS=10000

# 上游余额不足(provider_credit_insufficient)显著告警日志的节流窗口毫秒数,同一 provider 窗口内只写一条显著日志(count 仍累计,/api/health 的 creditAlert 快照实时)。默认 3600000(1h)。
# MEIAO_CREDIT_ALERT_THROTTLE_MS=3600000

# 存储合并守卫:「无身份活跃占位」(无 backendJobId/providerTaskId 等、status 还在 generating/pending)超过该毫秒龄即标结构化失败(errorCode=identityless_placeholder_expired)。默认 21600000(6h,远大于任何正常提交耗时)。
# MEIAO_IDENTITYLESS_ACTIVE_TTL_MS=21600000

# ── 智能体 tool calling 中转站（第2期：生图工具调用）────────────
# 配置后，modelPolicy.toolCallingProvider='openai_compatible' 的智能体走原生 tool calling 对话
# OPENAI_COMPATIBLE_API_KEY=sk-xxxx
# OPENAI_COMPATIBLE_BASE_URL=https://maxforai.top
# 允许的模型白名单（逗号分隔），防止误配不存在模型导致 503
# OPENAI_COMPATIBLE_MODELS=gpt-5.4,gpt-5.5
# 请求超时（毫秒），默认 240000
# OPENAI_COMPATIBLE_TIMEOUT_MS=240000
# responses 端点路径，默认 /v1/responses；第4期多工具的 web_search 只走 responses
# OPENAI_COMPATIBLE_RESPONSES_PATH=/v1/responses

# ── AI 客服 Chatwoot 自动回复 ─────────────────
# 默认复用 OPENAI_COMPATIBLE_DEFAULT_MODEL 或 OPENAI_COMPATIBLE_MODELS 的第一个模型。
# CHATWOOT_AI_MODEL=gpt-5.4
# 可选：给 /api/chatwoot/ai-webhook 增加共享密钥；配置后 Chatwoot webhook URL 需追加 ?secret=同值，
# 或在上游转发时带 x-meiao-webhook-secret 请求头。本地测试不配置则允许直接调用。
# MEIAO_CHATWOOT_AI_WEBHOOK_SECRET=

# ── 智能工厂模型供应商 / CLI 工具（Smart Factory）────────────
# 智能工厂模型页的 credentialRef 使用 env:OPENAI_COMPATIBLE_API_KEY 等引用，不保存明文密钥。
# OPENAI_COMPATIBLE_API_KEY=sk-xxxx
# 飞书表格 CLI executor。必须是 JSON 数组，后台用 execFile 无 shell 执行，并通过 stdin 传入 {"executorRef","args"}。
# 不配置时 feishu.create_sheet 会明确失败，不会返回假链接。
# SMART_FACTORY_CLI_FEISHU_CREATE_SHEET_COMMAND=["node","/opt/meiao-tools/feishu-create-sheet.mjs"]

# ── 知识库 RAG embedding（第3期）────────────────
# EMBEDDING_PROVIDER=doubao
# DOUBAO_EMBEDDING_API_KEY=ark-xxxx
# DOUBAO_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-251215
# EMBEDDING_MIN_SIMILARITY=0.3
# EMBEDDING_TIMEOUT_MS=30000

# ── 智能体多工具（第4期）────────────────
# 复用第2期 OPENAI_COMPATIBLE_*。V2 对话走 /v1/responses 端点（支持 web_search）。
# 工具调用循环上限，防止模型反复调用工具失控；默认 5。
# AGENT_TOOL_MAX_ROUNDS=5
# 多图独立输出规划欠覆盖时的模型修复轮数上限；默认 2。仍不完整则快速失败，不执行单张伪完成。
# AGENT_IMAGE_PLAN_REPAIR_MAX_ROUNDS=2
